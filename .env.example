# --- Data -------------------------------------------------------------
# Leave DATABASE_URL empty to run on the built-in in-memory demo dataset.
# Set it to use PostgreSQL (run `npm run db:migrate && npm run db:seed` first).
DATABASE_URL=
SIZEMEMO_ORG_ID=00000000-0000-0000-0000-000000000001

# --- AWS --------------------------------------------------------------
AWS_REGION=us-east-1
# S3 bucket for permitted product images and supporting files (feedback CSVs).
SIZEMEMO_S3_BUCKET=

# Amazon Bedrock (Claude via the Bedrock Mantle Messages endpoint).
# Leave BEDROCK_ENABLED=false to use the deterministic keyword classifier.
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# --- HubSpot ----------------------------------------------------------
# Private app token with crm.objects.contacts.write / companies / deals scopes.
# Leave empty and demo requests are stored locally only.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_DEMO_PIPELINE_ID=
HUBSPOT_DEMO_STAGE_ID=
